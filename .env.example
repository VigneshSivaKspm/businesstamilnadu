# ── Frontend (exposed to the browser — never put secrets in VITE_ variables) ──
# Public site URL used for canonical links and OpenGraph metadata.
VITE_SITE_URL=https://businesstamilnadu.in
# Set to "false" to run the public site on bundled sample data with no API.
VITE_USE_API=true

# ── API server (server-side only) ──
NODE_ENV=development
PORT=4000
# MongoDB connection string, e.g. from MongoDB Atlas → Connect → Drivers.
MONGODB_URI=
MONGODB_DB=business_tamil_nadu
# How long an admin stays signed in.
SESSION_TTL_HOURS=12
# Only needed if the frontend is hosted on a different origin than the API.
CORS_ORIGIN=
# Set to "true" when running behind a reverse proxy (Nginx, Render, Railway…).
TRUST_PROXY=false
