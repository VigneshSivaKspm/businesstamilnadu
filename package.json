{
  "name": "business-tamil-nadu",
  "private": true,
  "version": "1.0.0",
  "description": "Business Tamil Nadu \u00e2\u20ac\u201d Tamil Nadu's statewide business discovery platform (businesstamilnadu.in)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:demo": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:api:demo\"",
    "api:demo": "node --env-file-if-exists=.env server/scripts/demo.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --test \"server/test/**/*.test.ts\"",
    "preview": "vite preview",
    "admin:create": "node --env-file-if-exists=.env server/scripts/create-admin.ts",
    "db:seed": "node --env-file-if-exists=.env server/scripts/seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "mongodb": "^7.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "mongodb-memory-server-core": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
